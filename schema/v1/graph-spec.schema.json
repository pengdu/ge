{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ge.dev/schema/graph/v1",
  "title": "GraphSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "name", "nodes", "edges"],
  "properties": {
    "kind": {"const": "GraphSpec"},
    "schema_version": {"const": 1},
    "$id": {"type": "string"},
    "allow_unknown_fields": {"type": "boolean", "default": false},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "description": {"type": "string", "maxLength": 4096},
    "options": {"type": "object"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/$defs/edge"}
    }
  },
  "$defs": {
    "nodeId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
    },
    "endpoint": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}\\.[A-Za-z][A-Za-z0-9_.-]{0,127}$"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operator"],
      "properties": {
        "id": {"$ref": "#/$defs/nodeId"},
        "operator": {"type": "string", "minLength": 1, "maxLength": 256},
        "executor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {"enum": ["auto", "cpu", "gpu"]},
            "device_id": {"type": "integer", "minimum": 0}
          }
        },
        "parallelism": {"type": "integer", "minimum": 1},
        "options": {"type": "object"},
        "labels": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "id": {"$ref": "#/$defs/nodeId"},
        "from": {"$ref": "#/$defs/endpoint"},
        "to": {"$ref": "#/$defs/endpoint"},
        "feedback": {"type": "boolean", "default": false},
        "sync": {"enum": ["aligned", "latest", "any"]},
        "queue": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "capacity": {"type": "integer", "minimum": 1},
            "policy": {"enum": ["block", "drop_oldest", "drop_newest"]},
            "max_packet_bytes": {"type": "integer", "minimum": 1}
          }
        }
      }
    }
  }
}
