{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ge.dev/schema/plugin/v1",
  "title": "PluginManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "plugin_id", "library", "abi", "build_fingerprint", "operators", "no_owned_threads"],
  "properties": {
    "kind": {"const": "PluginManifest"},
    "schema_version": {"const": 1},
    "$id": {"type": "string"},
    "plugin_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,255}$"},
    "library": {"type": "string", "pattern": "^(?!.*\\.\\.)[^/].*\\.so$"},
    "abi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor"],
      "properties": {
        "major": {"type": "integer", "minimum": 1},
        "minor": {"type": "integer", "minimum": 0}
      }
    },
    "build_fingerprint": {"type": "string", "minLength": 1},
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1}
        }
      }
    },
    "resources": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "operators": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "max_inference_ms": {"type": "integer", "minimum": 1},
    "no_owned_threads": {"const": true}
  }
}
